# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insurance_lead_gen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j Graph Database
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_REST_PORT=6334

# NATS Message Broker
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# JWT & Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# API Rate limiting
API_RATE_LIMIT_POINTS=60
API_RATE_LIMIT_DURATION_SECONDS=60

# API Ports
API_PORT=3000
DATA_SERVICE_PORT=3001
ORCHESTRATOR_PORT=3002

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Application
NODE_ENV=development
APP_NAME=insurance-lead-gen-ai
APP_URL=http://localhost:3000

# ============================================
# CRM Integrations (Phase 15.1.2)
# ============================================

# Salesforce OAuth
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3001/api/v1/crm/oauth/salesforce/callback
SALESFORCE_WEBHOOK_SECRET=

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3001/api/v1/crm/oauth/hubspot/callback
HUBSPOT_WEBHOOK_SECRET=

# Pipedrive OAuth / API Key
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://localhost:3001/api/v1/crm/oauth/pipedrive/callback
PIPEDRIVE_API_KEY=
PIPEDRIVE_WEBHOOK_SECRET=

# Import Settings
MAX_IMPORT_FILE_SIZE=10485760
IMPORT_BATCH_SIZE=100
MAX_CONCURRENT_IMPORTS=5
IMPORT_TIMEOUT_MS=3600000

# ============================================
# Monitoring & Observability (Phase 6.3 & Run 19.3)
# ============================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SERVER_ROOT_URL=https://monitoring.insurance-lead-gen.com

# Loki
LOKI_PORT=3100
LOKI_RETENTION=720h  # 30 days
LOKI_INGESTION_RATE_MB=10

# Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_STORAGE_TYPE=elasticsearch
JAEGER_ES_URL=http://elasticsearch:9200

# AlertManager
ALERTMANAGER_PORT=9093
ALERTMANAGER_CLUSTER_PORT=9094

# Exporters
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# Production Monitoring (Run 19.3)
MONITORING_NAMESPACE=monitoring
GRAFANA_HOST=grafana.insurance-lead-gen.com
PROMETHEUS_HOST=prometheus.insurance-lead-gen.com
ALERTMANAGER_HOST=alertmanager.insurance-lead-gen.com
JAEGER_HOST=jaeger.insurance-lead-gen.com
STORAGE_CLASS=gp3
MONITORING_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Alert Notifications
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=
ALERT_EMAIL_FROM=alerts@insurance-lead-gen.com
ALERT_EMAIL_TO=team@insurance-lead-gen.com
SMTP_SERVER=smtp.gmail.com:587

# ============================================
# Security & Compliance (Phase 6.6 & 13.2)
# ============================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_RATE_LIMITING=true

# Encryption
ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32
ENCRYPTION_ALGORITHM=aes-256-gcm

# Secrets Management
SECRETS_BACKEND=env  # Options: env, aws, vault
AWS_SECRETS_MANAGER_REGION=us-east-1
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
SECRETS_CACHE_TTL=300000  # 5 minutes

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_DB_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_ARCHIVE_AFTER_DAYS=365  # cold storage after 1 year
AUDIT_LOG_BATCH_DELAY_MS=100
AUDIT_LOG_BATCH_SIZE=100
AUDIT_LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000  # Comma-separated for multiple origins
CORS_CREDENTIALS=true

# Session
SESSION_SECRET=  # Generate with: openssl rand -base64 32
SESSION_MAX_AGE=86400000  # 24 hours
SESSION_ABSOLUTE_TIMEOUT=2592000000  # 30 days
SESSION_INACTIVITY_TIMEOUT=1800000  # 30 minutes
SESSION_CONCURRENT_SESSIONS=5

# Data Privacy & GDPR
DATA_RETENTION_DAYS=365
ENABLE_GDPR_FEATURES=true

# Security Headers
ENABLE_SECURITY_HEADERS=true
CSP_REPORT_ONLY=false

# ============================================
# OAuth/SSO Configuration (Phase 13.2)
# ============================================

# SSO Enable/Disable
SSO_ENABLED=false
SSO_DEFAULT_PROVIDER=google
SSO_ENFORCE_MFA=false
SSO_ALLOWED_DOMAINS=  # Comma-separated domains (e.g., company.com,partner.org)
SSO_AUTO_PROVISION_USERS=true
SSO_SESSION_TIMEOUT=86400000  # 24 hours
SSO_SINGLE_LOGOUT_ENABLED=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ACCESS_SECRET=  # Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=  # Generate with: openssl rand -base64 32
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=insurance-lead-gen
JWT_AUDIENCE=insurance-lead-gen-api

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback

# Microsoft Azure AD OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
MICROSOFT_TENANT_ID=common

# Generic OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_ISSUER=
OIDC_JWKS_URI=

# ============================================
# Password Policy (Phase 13.2)
# ============================================

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_PREVENT_COMMON=true
PASSWORD_PREVENT_REUSED=5
PASSWORD_PREVENT_SIMILAR=true
PASSWORD_PREVENT_KEYBOARD=true
PASSWORD_PREVENT_EMAIL=true
PASSWORD_EXPIRATION_DAYS=90
BCRYPT_ROUNDS=12

# ============================================
# Account Lockout Policy (Phase 13.2)
# ============================================

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=900000  # 15 minutes
FAILED_ATTEMPT_WINDOW=300000  # 5 minutes
NOTIFY_ON_LOCKOUT=true
NOTIFY_ON_SUSPICIOUS=true

# ============================================
# Device Fingerprinting (Phase 13.2)
# ============================================

DEVICE_FINGERPRINTING_ENABLED=true
DEVICE_TRUST_DURATION=2592000000  # 30 days
MAX_DEVICES_PER_USER=5
DEVICE_RISK_THRESHOLD=70
BLOCK_SUSPICIOUS_DEVICES=false
STORE_IP_HISTORY=true

# ============================================
# IP Policy (Phase 13.2)
# ============================================

IP_WHITELIST=  # Comma-separated IPs
IP_BLACKLIST=  # Comma-separated IPs

# ============================================
# MFA Settings (Phase 13.2)
# ============================================

MFA_ENABLED=false
REQUIRE_MFA=false
MFA_ISSUER=Lead Management
MFA_SERVICE_NAME=lead-management

# ============================================
# Security Headers (Phase 13.2)
# ============================================

HSTS_MAX_AGE=31536000  # 1 year
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
CSP_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=true
REFERRER_POLICY=strict-origin-when-cross-origin